    {
      "name": "Students - Admin (should succeed)",
      "item": [
        {
          "name": "Find Auto-Created Student Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] },
            "description": "There is no POST /api/students - the Student profile for {{userEmail}} was created automatically during registration. This finds it and captures {{studentId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const students = pm.response.json();",
                  "const userEmail = pm.collectionVariables.get('userEmail');",
                  "const match = students.find(s => s.email === userEmail);",
                  "pm.test('auto-created profile exists for the registered user', function () {",
                  "  pm.expect(match).to.not.be.undefined;",
                  "});",
                  "if (match) {",
                  "  pm.collectionVariables.set('studentId', match.id);",
                  "  pm.test('profile has no course yet', function () {",
                  "    pm.expect(match.courseId).to.be.null;",
                  "  });",
                  "  pm.test('profile is linked to the user account', function () {",
                  "    pm.expect(match.userId).to.not.be.null;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
